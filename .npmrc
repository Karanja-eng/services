# Fundi Studio — npm configuration
#
# Why legacy-peer-deps is enabled
# -------------------------------
# This application hosts three different 3D/CAD stacks in one bundle and they
# declare mutually incompatible *peer ranges* for the same `three` package:
#
#   @mlightcad/cad-simple-viewer@1.7.5   peer: three ^0.172.0
#   @thatopen/components@3.3.3           peer: three >=0.175.0
#
# Only one `three` instance may exist in the bundle: MLightCAD's renderer, React
# Three Fiber and That Open all draw with the same runtime, and two copies break
# instanceof checks between them. The repository therefore stays on three 0.172.0
# (which MLightCAD 1.7.5 and R3F 9.4 are verified against) and That Open runs on
# it too.
#
# That is not a guess: `npm run verify:thatopen-three` executes
# `scripts/verify/thatopen-three-compat.mjs`, which asserts that every symbol
# @thatopen/components 3.3.3 and @thatopen/fragments 3.3.3 import from `three`
# exists in the installed three, and exercises the instanced-geometry and
# uniform-cloning paths the fragment batcher depends on. That check passes on
# three 0.172.0, so the declared `>=0.175.0` range is stricter than the actual
# runtime requirement.
#
# legacy-peer-deps stops npm from refusing the install because of that range.
# The consequence is that peer dependencies are not auto-installed, so every peer
# that is actually needed (three, web-ifc, camera-controls, lodash-es,
# @thatopen/fragments) is declared as a direct dependency in package.json.
# Do not remove this file without re-running the compatibility check.
legacy-peer-deps=true
