# Ignore everything
*

# Allow source files
!*.py
!*.jsx
!/src/**/*.js
!/src/**/*.ts
!/src/**/*.tsx
!*.hpp
!*.cpp

# Allow directories
!*/

        
# Keep gitignore itself
!.gitignore

# Allow build output for deployment
!/build/

# Allow public assets
!/public/
!*.html
!*.css
!*.json
!*.png
!*.jpg
!*.svg

# Allow configs
!package.json
!package-lock.json
!tailwind.config.js
!postcss.config.js
!babel.config.js
!webpack.config.js
!index.js
!App.js
!descriptions.js
!componentRegistry.js
!3D_INTEGRATION_GUIDE.js
!builderCADExporter.js
!StructuralClasses.js
!cadGeometryUtils.js
!cadStorageService.js
!componentRegistry.js
!builderCADExporter.js
!StructuralClasses.js
!SteelAnalysisAdapter.js
!SteelPipelineAdapter.js
!SteelStructureAdapter.js

!Manholes_taking_off_1.json

!universal_beams_sections.json
!universal_bearing_piles.json
!universal_columns.json

!Gemini_Generated_Image_nwcnzmnwcnzmnwcn (1).png


# Allow GitHub workflows
!.github/

# Allow Docker configuration
!Dockerfile
!src/Backend/Dockerfile
!docker-compose.yml
!README_DOCKER.md
!start_app.bat

# Always ignore node_modules
/node_modules/

# --- CAD / BIM / IFC integration (feature/cad-bim-ifc-integration) -----------
# Source of the interoperability layer is already covered by !*.py and
# !/src/**/*.js. The entries below allow the report and the *generated sample
# artefacts* that the /interop/cad-bim route loads, so the route works without
# running the Python pipeline first.
!/docs/
!/docs/*.md
!/public/ifc/
!/public/ifc/*.ifc
!/public/ifc/*.dxf
!/public/ifc/*.json
# web-ifc runtime asset, copied from node_modules/web-ifc (MPL-2.0)
!/public/web-ifc/
!/public/web-ifc/*.wasm

# Agent execution journals (chats/) are committed alongside the code.
!/chats/
!/chats/*.md

# Local scratch/output from the integration tooling: never commit these
/.venv-ifc/
/.pip-dl/
/.pip-tmp/
/.poc-out/
/.poc-test-tmp/
/.probe/
/src/Backend/cad_ifc/data/
/*.log

# Build helper (postinstall resolver fix for MLightCAD + three exports map)
!/scripts/
!/scripts/*.js
!/scripts/*.mjs
!/scripts/verify/
!/scripts/verify/*.mjs

# --- That Open BIM viewer runtime assets -------------------------------------
# Copied from node_modules by scripts/copy-cad-bim-assets.js (postinstall) so the
# browser can fetch the fragments worker and the web-ifc WASM by URL. Generated,
# but committed so a clone can run the route without reinstalling; manifest.json
# records which package versions produced them.
!/public/thatopen/
!/public/thatopen/*.mjs
!/public/thatopen/*.wasm
!/public/thatopen/*.json

# --- Generated CAD artefacts (public/cad) ------------------------------------
# DXF drawings and canonical-model JSON produced by POST /api/cad-ifc/generate.
!/public/cad/
!/public/cad/*.dxf
!/public/cad/*.json

# --- Integration documentation ----------------------------------------------
!/docs/integration/
!/docs/integration/*.md

# npm configuration: pins the peer-resolution policy that lets three 0.172 serve
# both MLightCAD and That Open. Must be committed or `npm install` breaks.
!.npmrc

# Local scratch produced by the acceptance test suites
/.test-artifacts/

# --- Structural analysis (OpenSeesPy) ---------------------------------------
# The wheels are extracted here instead of installed by pip, because pip's
# `*.whl.metadata` step is blocked in the sandbox. This is generated, never committed.
/.venv-opensees/

# --- Solid modelling (OpenCascade.js) ----------------------------------------
# The kernel wrapper and the septic solid adapter are ES modules (.mjs) because the
# opencascade.js glue is ESM; the `!*.js` rule above does not cover .mjs, so without
# these lines the whole capability would be missing from a clone.
!/src/solid/
!/src/solid/*.mjs
!/src/analysis/
!/src/analysis/*.mjs
!/test/
!/test/*.mjs
!/scripts/solid/
!/scripts/solid/*.mjs

# Generated STEP files (one per solid component), produced by
# `node scripts/solid/septic-step.mjs`; committed so the artefacts are inspectable
# without running the 62 MB WASM kernel.
!/public/step/
!/public/step/*.step
!/public/step/*.json
