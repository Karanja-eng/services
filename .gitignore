# Ignore everything
*

# Allow source files
!*.py
!*.jsx
!/src/**/*.js
!/src/**/*.ts
!/src/**/*.tsx
!*.hpp
!*.cpp

# Allow directories
!*/

        
# Keep gitignore itself
!.gitignore

# Allow build output for deployment
!/build/

# Allow public assets
!/public/
!*.html
!*.css
!*.json
!*.png
!*.jpg
!*.svg

# Allow configs
!package.json
!package-lock.json
!tailwind.config.js
!postcss.config.js
!babel.config.js
!webpack.config.js
!index.js
!App.js
!descriptions.js
!componentRegistry.js
!3D_INTEGRATION_GUIDE.js
!builderCADExporter.js
!StructuralClasses.js
!cadGeometryUtils.js
!cadStorageService.js
!componentRegistry.js
!builderCADExporter.js
!StructuralClasses.js
!SteelAnalysisAdapter.js
!SteelPipelineAdapter.js
!SteelStructureAdapter.js

!Manholes_taking_off_1.json

!universal_beams_sections.json
!universal_bearing_piles.json
!universal_columns.json

!Gemini_Generated_Image_nwcnzmnwcnzmnwcn (1).png


# Allow GitHub workflows
!.github/

# Allow Docker configuration
!Dockerfile
!src/Backend/Dockerfile
!docker-compose.yml
!README_DOCKER.md
!start_app.bat

# Always ignore node_modules
/node_modules/

# --- CAD / BIM / IFC integration (feature/cad-bim-ifc-integration) -----------
# Source of the interoperability layer is already covered by !*.py and
# !/src/**/*.js. The entries below allow the report and the *generated sample
# artefacts* that the /interop/cad-bim route loads, so the route works without
# running the Python pipeline first.
!/docs/
!/docs/*.md
!/public/ifc/
!/public/ifc/*.ifc
!/public/ifc/*.dxf
!/public/ifc/*.json
# web-ifc runtime asset, copied from node_modules/web-ifc (MPL-2.0)
!/public/web-ifc/
!/public/web-ifc/*.wasm

# Local scratch/output from the integration tooling: never commit these
/.venv-ifc/
/.pip-dl/
/.pip-tmp/
/.poc-out/
/.poc-test-tmp/
/.probe/
/src/Backend/cad_ifc/data/
/*.log

# Build helper (postinstall resolver fix for MLightCAD + three exports map)
!/scripts/
!/scripts/*.js
