  "tying_reinforcement_formulas": [
    {
      "id": "EX-TY1",
      "name": "Peripheral ties",
      "formula": "≥ (20 + 4n_o) but ≤ 60 kN",
      "variables": {"n_o": "number of storeys"},
      "location": "Within 1.2m from edge of structure at each floor/roof",
      "source": "Section 5.1.9, page 36",
      "status": "DIRECTLY STATED"
    },
    {
      "id": "EX-TY2",
      "name": "Internal ties",
      "formula": "F_tie,int = [(gk + qk)/7.5] × (lr/5) × F1 ≥ Ft kN/m",
      "variables": {
        "gk_plus_qk": "sum of average permanent and variable floor loads (kN/m²)",
        "lr": "greater of distances between column/frame/wall centres supporting adjacent spans (m)",
        "Ft": "(20 + 4n_o) ≤ 60 kN/m"
      },
      "max_spacing": "1.5 × lr",
      "source": "Section 5.1.9, page 36",
      "status": "DIRECTLY STATED"
    },
    {
      "id": "EX-TY3",
      "name": "Horizontal ties to columns/walls",
      "formula": "Greater of: 2Ft ≥ ls/2.5 × Ft; AND 3% of total vertical load at that level",
      "variables": {"ls": "floor to ceiling height (m)"},
      "source": "Section 5.1.9, page 36",
      "status": "DIRECTLY STATED"
